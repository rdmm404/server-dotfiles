#!/bin/sh

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
[ -f "$HOME/.bash_secrets" ] && . "$HOME/.bash_secrets"

case ":$PATH:" in
    *:"$HOME/scripts":*) ;;
    *) export PATH="$HOME/scripts:$PATH" ;;
esac

export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in
    *:"$BUN_INSTALL/bin":*) ;;
    *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
esac

# Keep fnm initialization out of generic non-interactive shells.
# If a default fnm-managed Node install exists, expose its bin dir directly.
FNM_DEFAULT_BIN="$HOME/.local/share/fnm/aliases/default/bin"
if [ -d "$FNM_DEFAULT_BIN" ]; then
    case ":$PATH:" in
        *:"$FNM_DEFAULT_BIN":*) ;;
        *) export PATH="$FNM_DEFAULT_BIN:$PATH" ;;
    esac
fi
