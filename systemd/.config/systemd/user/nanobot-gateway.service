[Unit]
Description=Nanobot Gateway
After=network-online.target nanobot-whatsapp-bridge.service
Wants=network-online.target nanobot-whatsapp-bridge.service

[Service]
Type=simple
WorkingDirectory=%h/.nanobot/workspace
ExecStart=%h/.local/bin/nanobot gateway
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
