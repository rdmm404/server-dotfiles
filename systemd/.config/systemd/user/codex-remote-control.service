[Unit]
Description=Codex remote control bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:%h/.local/share/npm/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/fnm/aliases/default/bin/codex remote-control
Restart=always
RestartSec=5
StandardOutput=append:%h/.codex/remote-control.log
StandardError=append:%h/.codex/remote-control.log

[Install]
WantedBy=default.target
